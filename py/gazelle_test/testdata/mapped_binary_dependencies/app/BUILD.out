load("//tools:python_defs.bzl", "custom_py_binary", "custom_py_library", "workflow_job")

custom_py_binary(
    name = "cli",
    main = "cli.py",
    deps = [
        ":helper",
        "@pip//requests",
    ],
)

custom_py_binary(
    name = "cli_variant",
    main = "cli.py",
    deps = [
        ":helper",
        "@pip//requests",
    ],
)

custom_py_binary(
    name = "batch",
    srcs = glob(["batch_*.py"]),
    deps = ["//stale:dep"],
)

custom_py_binary(
    name = "selected",
    srcs = select({
        "//conditions:default": ["selected.py"],
    }),
    main = "selected_cli.py",
    deps = ["//manual:dep"],
)

workflow_job(
    name = "launch",
    main = "job_test.py",
)

custom_py_library(
    name = "batch_runner",
    srcs = ["batch_runner.py"],
    visibility = ["//visibility:public"],
    deps = ["@pip//requests"],
)

custom_py_library(
    name = "batch_worker",
    srcs = ["batch_worker.py"],
    visibility = ["//visibility:public"],
    deps = [":helper"],
)

custom_py_library(
    name = "helper",
    srcs = ["helper.py"],
    visibility = ["//visibility:public"],
)
