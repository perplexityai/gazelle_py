load("//tools:python_defs.bzl", "custom_py_binary", "workflow_job")

custom_py_binary(
    name = "cli",
    main = "cli.py",
    deps = ["//stale:dep"],
)

custom_py_binary(
    name = "cli_variant",
    main = "cli.py",
)

custom_py_binary(
    name = "batch",
    srcs = glob(["batch_*.py"]),
    deps = ["//stale:dep"],
)

workflow_job(
    name = "launch",
    main = "job_test.py",
)
